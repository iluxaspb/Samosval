rules_version = '2';
// EMULATOR ONLY. This deliberately denies the host/Line collections.
// It is not a replacement for any deployed project's rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function account() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return request.auth != null && account().status == 'active'; }
    function admin() { return active() && account().role == 'admin'; }
    function tab() { return active() && (admin() || 'timesheet' in get(/databases/$(database)/documents/settings/permissions).data.get(account().role,{}).get('tabs',[])); }
    function hostEdit() { return admin() || 'timesheet_edit' in get(/databases/$(database)/documents/settings/permissions).data.get(account().role,{}).get('actions',[]); }
    function config(objectId) { return get(/databases/$(database)/documents/workspaces/main_workspace/timesheetObjects/$(objectId)).data; }
    function grant(objectId,key) {
      return tab() && (admin() || config(objectId).acl.roles.get(account().role,{}).get(key,false) == true
        || config(objectId).acl.users.get(request.auth.uid,{}).get(key,false) == true);
    }
    function readArea(d,c) {
      return c == 'timesheetObjects' ? tab() :
        c == 'timesheetSheets' ? grant(d.objectId,'table.view') :
        c == 'timesheetDays' ? grant(d.objectId,'shift.view') :
        c == 'timesheetValues' ? (grant(d.objectId,'table.view') || grant(d.objectId,d.kind == 'work' ? 'plans.view' : 'materials.view')) :
        c == 'timesheetEntries' ? (grant(d.objectId,'table.view') || grant(d.objectId,'shift.view')) : false;
    }
    function writeArea(d,c,old) {
      return tab() && hostEdit() && (
        c == 'timesheetObjects' ? (
          (old == null ? admin() :
            (d.diff(old).affectedKeys().hasOnly(['request','revision','lastOpId','updatedBy','updatedName','updatedAt']) && grant(d.objectId,'request.edit'))
            || (d.acl == old.acl && grant(d.objectId,'settings.edit'))
            || (grant(d.objectId,'permissions.edit') && grant(d.objectId,'settings.edit')))
        ) : c == 'timesheetSheets' ? grant(d.objectId,'table.edit') :
        c == 'timesheetDays' ? grant(d.objectId,'shift.edit') :
        c == 'timesheetValues' ? grant(d.objectId,d.kind == 'work' ? 'plans.edit' : 'materials.edit') :
        c == 'timesheetEntries' ? grant(d.objectId,'shift.edit') && grant(d.objectId,d.kind == 'person' ? 'people.edit' : 'equipment.edit') : false
      );
    }
    function known(c) { return c in ['timesheetObjects','timesheetSheets','timesheetDays','timesheetValues','timesheetEntries']; }
    function dataValid(c,d) {
      return d.objectId is string && d.objectId.size() > 0 && d.objectId.matches('[A-Za-z0-9_-]+')
        && d.deleted is bool && (c == 'timesheetEntries' || d.schemaVersion == 1)
        && (c == 'timesheetObjects' ? d.startDate is string && d.startDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
             && d.acl is map && d.acl.roles is map && d.acl.users is map
             && d.volumeSource == 'manual' && d.request is map && d.works is list && d.materials is list
          : c == 'timesheetSheets' ? d.cells is map && d.cells.size() <= 5000 && d.name is string && d.name.size() <= 80
             && d.type in ['blank','template'] && d.rowCount is int && d.rowCount > 0 && d.rowCount <= 1000
             && d.colCount is int && d.colCount > 0 && d.colCount <= 100
          : d.date is string && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && d.shift in ['day','night']
             && d.scope == d.objectId + '|' + d.date.split('-')[0] + '-' + d.date.split('-')[1]
             && (c == 'timesheetDays' ? d.started is bool
               : c == 'timesheetValues' ? d.kind in ['work','material'] && d.entityId is string && d.unit is string
                  && d.quantity is number && d.quantity >= 0 && d.quantity <= 100000000
               : d.kind in ['person','equipment'] && d.entityId is string
                  && (d.minutes == null || (d.minutes is int && d.minutes >= 0 && d.minutes <= 1440))
                  && d.status in ['work','unfilled','off','absent']
                  && (d.status == 'work' ? d.minutes != null : d.status == 'unfilled' ? d.minutes == null : d.minutes == 0)));
    }
    function matchingChange(ch,c,id,old) {
      return ch.collection == c && ch.id == id && ch.before == old && ch.after == request.resource.data;
    }
    function envelope(c,id,old) {
      let d = request.resource.data;
      let op = getAfter(/databases/$(database)/documents/workspaces/main_workspace/timesheetChanges/$(d.lastOpId)).data;
      return d.updatedBy == request.auth.uid && d.updatedAt is number && d.updatedName is string
        && d.revision == (old == null ? 1 : old.revision + 1)
        && (old == null || (d.objectId == old.objectId && (c in ['timesheetObjects','timesheetSheets'] ||
            (d.date == old.date && d.shift == old.shift && d.scope == old.scope))))
        && op.uid == request.auth.uid && op.changes.size() > 0 && op.changes.size() <= 4
        && (matchingChange(op.changes[0],c,id,old)
          || (op.changes.size() > 1 && matchingChange(op.changes[1],c,id,old))
          || (op.changes.size() > 2 && matchingChange(op.changes[2],c,id,old))
          || (op.changes.size() > 3 && matchingChange(op.changes[3],c,id,old)));
    }
    function receiptChange(ch,opId) {
      let path = /databases/$(database)/documents/workspaces/main_workspace/$(ch.collection)/$(ch.id);
      let after = getAfter(path).data;
      return known(ch.collection) && after == ch.after && after.lastOpId == opId
        && after.updatedBy == request.auth.uid
        && (exists(path) ? ch.before == get(path).data && after.revision == get(path).data.revision + 1
          : ch.before == null && after.revision == 1);
    }
    match /workspaces/main_workspace/{c}/{id} {
      allow read: if known(c) && tab() && (!exists(/databases/$(database)/documents/workspaces/main_workspace/$(c)/$(id)) || readArea(resource.data,c));
      allow create: if known(c) && dataValid(c,request.resource.data) && writeArea(request.resource.data,c,null)
        && (c != 'timesheetObjects' || id == request.resource.data.objectId) && envelope(c,id,null);
      allow update: if known(c) && dataValid(c,request.resource.data) && writeArea(request.resource.data,c,resource.data)
        && envelope(c,id,resource.data);
      allow delete: if false;
    }
    match /workspaces/main_workspace/timesheetChanges/{id} {
      allow read: if tab();
      allow create: if tab() && hostEdit() && request.resource.data.uid == request.auth.uid
        && request.resource.data.changes is list && request.resource.data.changes.size() > 0 && request.resource.data.changes.size() <= 4
        && receiptChange(request.resource.data.changes[0],id)
        && (request.resource.data.changes.size() < 2 || receiptChange(request.resource.data.changes[1],id))
        && (request.resource.data.changes.size() < 3 || receiptChange(request.resource.data.changes[2],id))
        && (request.resource.data.changes.size() < 4 || receiptChange(request.resource.data.changes[3],id));
      allow update, delete: if false;
    }
  }
}
