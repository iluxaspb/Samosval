# Synology TEST only. Copy to .env.test; never commit the real values.
POSTGRES_DB=samosval_test
POSTGRES_USER=samosval_test
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Must match the Firebase Auth project for TEST; do not mix production tokens.
FIREBASE_PROJECT_ID=samosval-offline
# Exact browser origins only; no paths, no trailing slash, no wildcard.
ALLOWED_ORIGINS=https://iluxaspb.github.io
WORKSPACE_ID=main_workspace
# Explicit opt-in only after verifying TEST-only Firebase rules and NAS backup.
TEST_REPLICA_ENABLED=0
# EXPERIMENTAL and deliberately disabled: Firestore ownership permits for NAS POSTs.
# Only activate on a disposable TEST data set after the confirmed mirror is ready.
# While enabled, NAS rejects writes if Firebase coordinator becomes unreachable.
# Not a working Firebase failover / reverse-sync switch.
TEST_WRITER_FENCE_ENABLED=0
# A service account with Firestore-only access to samosval-offline must be mounted
# as a read-only file by the NAS administrator; do not commit its contents.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/samosval-test-replica.json
