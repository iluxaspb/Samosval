# Synology TEST only. Copy to .env.test; never commit the real values.
POSTGRES_DB=samosval_test
POSTGRES_USER=samosval_test
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Must match the Firebase Auth project for TEST; do not mix production tokens.
FIREBASE_PROJECT_ID=samosval-test
# Exact browser origins only; no paths, no trailing slash, no wildcard.
ALLOWED_ORIGINS=https://iluxaspb.github.io
WORKSPACE_ID=main_workspace
