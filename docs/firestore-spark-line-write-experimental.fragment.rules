// EMULATOR-ONLY EXPERIMENT. A single status update includes the new line
// state and the immutable, append-only log/receipt. No cross-document getAfter()
// cycles and one Firestore write per truck action. NEVER DEPLOY until every
// module and NAS reverse replay is certified.
match /samosval_test_replica/v1/{typedCollection}/{documentId} {
  function mirror() {
    return get(/databases/$(database)/documents/samosval_test_replica/v1).data;
  }
  function owner() {
    return get(/databases/$(database)/documents/samosval_test_replica/write_owner).data;
  }
  function access() {
    let collectionName = 'access_' + mirror().generation;
    return get(/databases/$(database)/documents/samosval_test_replica/v1/$(collectionName)/$(request.auth.uid)).data;
  }
  function activeConfig() {
    let collectionName = 'typed_config_' + mirror().generation;
    return get(/databases/$(database)/documents/samosval_test_replica/v1/$(collectionName)/active).data;
  }
  function truck(truckId) {
    let collectionName = 'typed_trucks_' + mirror().generation;
    return get(/databases/$(database)/documents/samosval_test_replica/v1/$(collectionName)/$(truckId)).data;
  }
  function typed(prefix) {return typedCollection == prefix + mirror().generation;}
  function authorized() {
    let m = mirror();
    let o = owner();
    let a = access();
    let c = activeConfig();
    return request.auth != null &&
      m.protocol == 1 && m.projectId == 'samosval-offline' &&
      m.readyForFailover == true &&
      o.protocol == 1 && o.projectId == 'samosval-offline' &&
      o.owner == 'firebase' && o.holder == 'firebase_reserve' &&
      o.generation == m.generation && o.observedSequence == m.lastSequence &&
      o.pending.size() == 0 && o.epoch is int && o.epoch > 0 &&
      a.projectId == 'samosval-offline' && a.generation == m.generation &&
      a.uid == request.auth.uid && a.active == true && a.lineRead == true &&
      a.sourceSequence <= m.lastSequence && a.profile.status == 'active' &&
      a.profile.deleted == false && 'line' in a.permissions.tabs &&
      c.protocol == 1 && c.projectId == 'samosval-offline' &&
      c.generation == m.generation && c.active == true &&
      c.sourceSequence <= m.lastSequence &&
      c.shiftId.size() > 0 && c.cycleMinutes is int &&
      c.cycleMinutes >= 15 && c.cycleMinutes <= 10080;
  }
  function gapOK(op) {
    return resource.data.lastLoadAt == null ||
      (request.time - resource.data.lastLoadAt >=
       duration.value(activeConfig().cycleMinutes, 'm') &&
       request.time - resource.data.lastLoadAt >=
       duration.value(op.cycleMinutes, 'm'));
  }
  function statusUpdate() {
    let b = resource.data;
    let n = request.resource.data;
    let count = b.reserveHistory.size();
    let op = n.reserveHistory[count];
    return typed('typed_status_') && authorized() &&
      b.protocol == 1 && b.projectId == 'samosval-offline' &&
      b.generation == mirror().generation &&
      b.sourceSequence <= mirror().lastSequence &&
      documentId == b.id && b.onLine == true &&
      b.shiftId == activeConfig().shiftId &&
      b.reserveHistory is list && count < 256 &&
      n.reserveHistory.size() == count + 1 &&
      n.reserveHistory[0:count] == b.reserveHistory &&
      n.diff(b).affectedKeys().hasOnly([
        'cycleRevision','arrivedAt','lastLoadAt','lastLogId',
        'loadedAfterArrive','lastOperationId','lastActionType',
        'lastActorUid','reserveHistory'
      ]) &&
      n.cycleRevision == b.cycleRevision + 1 &&
      n.lastActorUid == request.auth.uid &&
      op.keys().hasAll(['operationId','uid','type','epoch','generation',
       'truckId','shiftId','expectedRevision','revision','cycleMinutes',
       'requestHash','at','logId','volume','isGAI']) &&
      op.keys().hasOnly(['operationId','uid','type','epoch','generation',
       'truckId','shiftId','expectedRevision','revision','cycleMinutes',
       'requestHash','at','logId','volume','isGAI']) &&
      op.operationId is string && op.operationId.size() > 0 &&
      op.operationId.size() <= 128 &&
      op.uid == request.auth.uid &&
      op.type == n.lastActionType &&
      (op.type == 'arrive' || op.type == 'load') &&
      ('action_' + op.type) in access().permissions.actions &&
      op.epoch == owner().epoch &&
      op.generation == mirror().generation &&
      op.truckId == documentId && op.shiftId == b.shiftId &&
      op.expectedRevision == b.cycleRevision &&
      op.revision == n.cycleRevision &&
      op.cycleMinutes is int && op.cycleMinutes >= 15 &&
      op.cycleMinutes <= 10080 &&
      op.requestHash is string && op.requestHash.size() == 64 &&
      op.at == request.time &&
      n.lastOperationId == op.operationId &&
      gapOK(op) &&
      (
        (op.type == 'arrive' &&
         b.arrivedAt == null && n.arrivedAt == request.time &&
         n.lastLoadAt == b.lastLoadAt &&
         n.lastLogId == b.lastLogId &&
         n.loadedAfterArrive == false &&
         op.logId == '' && op.volume == 0 && op.isGAI == false)
        ||
        (op.type == 'load' &&
         b.arrivedAt is timestamp && request.time >= b.arrivedAt &&
         n.arrivedAt == null && n.lastLoadAt == request.time &&
         n.lastLogId == 'load_' + op.operationId &&
         n.loadedAfterArrive == true &&
         op.logId == n.lastLogId &&
         truck(documentId).id == documentId &&
         truck(documentId).sourceSequence <= mirror().lastSequence &&
         op.isGAI == truck(documentId).isGAI &&
         op.volume == truck(documentId).volume)
      );
  }

  allow get: if request.auth != null && access().uid == request.auth.uid &&
    access().active == true && access().lineRead == true &&
    (typed('typed_config_') || typed('typed_trucks_') || typed('typed_status_'));
  allow list: if false;
  allow update: if request.auth != null &&
    typed('typed_status_') && statusUpdate();
  allow create, delete: if false;
}
